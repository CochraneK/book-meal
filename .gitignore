# ── Python ─────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.env

# ── 系统 / 编辑器 ──────────────────────────────────────
.DS_Store
*.tmp

# ── 版权：原著与含正文的中间产物 ────────────────────────
# 仓库只发布脱敏后的章节索引与聚合结果，绝不分发原书正文
明朝那些事儿.txt
data/chapters.json

# ── 版权：teardown/ 工程自带的规则 ──────────────────────
# teardown/ 目录下另有 .gitignore，负责该工程的原文排除
# （《天才基本法》《我在废土世界扫垃圾》两本 TXT）与产物排除（out/）。
# **改版权规则时以 teardown/.gitignore 为准**——git 的子目录 .gitignore 会正常生效，
# 此处不重复写，避免两边不同步反而产生漏纱布假象。
# CI 的「版权合规巡检」会连同子目录一并检查，漏了会在那里被拦下。

# ── 构建产物 ───────────────────────────────────────────
# web target 的分离资源产物（可随时由 src/build.py 重新生成）
dist/
_publish/
# CI 构建中间产物
.ci/

# ── 本地记忆与调试工作区 ───────────────────────────────
# .workbuddy/ 是本机工作记忆（日志与长期项目笔记），属本地状态，不入库。
# teardown/.gitignore 里也有同一条——两边保持一致，别只改一边。
.workbuddy/

# ── 临时工作区 ─────────────────────────────────────────
# .dump/ 是一次性调试脚本与中间输出的本地工作区，不入版本控制；
# 其中被 CI 依赖的工具已提升到 tests/（如 tests/browser_check.py）。
.dump/
_dump/

# ── 论文试点工程：独立 git 仓库（自带历史与远程）──────────
papers_pilot/
